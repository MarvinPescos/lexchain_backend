# Copy to .env and fill in real values:  cp .env.example .env
# .env and .env.production are gitignored; this file is committed, so it must
# never contain real credentials.

# --- REQUIRED: Database Configuration (PostgreSQL) ---
DB_NAME=lexChain
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=db
DB_PORT=5432

# --- REQUIRED: Connection URLs ---
# Built from the values above via dotenv interpolation. In production, set
# DB_URL directly to the connection string your provider gives you.
DB_URL=postgresql+asyncpg://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}
TEST_DB_URL=postgresql+asyncpg://${DB_USER}:${DB_PASS}@localhost:5432/${DB_NAME}_test

# --- REQUIRED: Application Settings ---
ENVIRONMENT=development

# --- OPTIONAL: Connection pool tuning ---
# Every value below has a working default in app/core/config.py. Leave them
# commented out for local development; uncomment only to override.

# Log every SQL statement to stdout. Useful for debugging a specific query,
# noisy enough that you will not want it on permanently.
# DB_ECHO=false

# Test each connection for liveness before handing it out. Cheap, and it
# survives a laptop sleep or a `docker compose restart db`.
# DB_POOL_PRE_PING=true

# Connections held open, and how many more may be opened under load.
# Defaults are fine until you are serving real concurrency.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Seconds before a pooled connection is discarded and reopened; -1 disables.
# Managed Postgres (Neon, Supabase, RDS behind pgbouncer) cuts idle
# connections, so keep this BELOW your provider's idle timeout or you will
# get intermittent stale-connection errors.
# DB_POOL_RECYCLE=1800
